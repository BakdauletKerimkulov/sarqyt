            "fileOutput": "android/app/src/business/google-services.json"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "sarqyt-1ab95",
          "appId": "1:1072615959986:ios:c061e01ea24d05b588c8ab",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options_client.dart": {
          "projectId": "sarqyt-1ab95",
          "configurations": {
            "android": "1:1072615959986:android:1c4694c78524a4ec88c8ab",
            "ios": "1:1072615959986:ios:c061e01ea24d05b588c8ab"
          }
        },
        "lib/firebase_options_business.dart": {
          "projectId": "sarqyt-1ab95",
          "configurations": {
            "android": "1:1072615959986:android:43deb267612960d888c8ab",
            "web": "1:1072615959986:web:845a0a4381e8a2b188c8ab"
          }
        }
      }
    }
  },
  "functions": {
    "codebase": "default",
    "disallowLegacyRuntimeConfig": true,
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "source": "functions"
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
