{
  "include": [
    ".eslintrc.js",
    "vitest.config.ts",
    "test",
    "src/**/*.test.ts"
  ],
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "rootDir": ".",
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017"
  }
}
