# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase
.env
.firebase/
firebase-export-*/
functions/build/

# Platform secrets
# Per-flavor since spec 050 [L7]: each developer runs `flutterfire configure`
# locally. Neither the build, CI, nor `flutter test` depends on these files —
# the Google Services Gradle plugin is deliberately not applied [L6].
android/app/src/client/google-services.json
android/app/src/business/google-services.json
ios/Runner/GoogleService-Info.plist

# Envied generated secrets
lib/env.g.dart

# VS Code
# Игнорируется содержимое, а не сам каталог: при `.vscode/` git отсекает обход
# каталога целиком, и последующее `!` для файла внутри него не действует.
.vscode/*
# Исключение: launch.json ведётся в репозитории — [L1] включает его в состав
# спеки 050, и без этой строки правка четырёх пофлейворных конфигураций была бы
# не видна в дифе PR.
!.vscode/launch.json
plan.txt

# состояние agentic-цикла (допуск gate, логи ретраев, вердикты ревью)
.gate/
