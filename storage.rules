rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    /// storeShips-based access check (1 exists() call).
    function hasStoreAccess(storeId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/storeShips/$(storeId + '_' + request.auth.uid));
    }

    /// Legacy fallback for old documents without storeShip.
    function isStoreOwner(storeId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/stores/$(storeId))
        && request.auth.uid == firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerId;
    }

    match /stores/{storeId}/items/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        || hasStoreAccess(storeId) || isStoreOwner(storeId);
    }
  }
}
